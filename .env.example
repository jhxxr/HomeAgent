HOST=127.0.0.1
PORT=3210
PUBLIC_URL=http://localhost:3210
HOMEAGENT_DB=./data/server.sqlite
# Run npm run init to generate strong values. ADMIN_PASSWORD is optional when XAuth is configured.
ADMIN_PASSWORD=
SESSION_SECRET=
# Optional XAuth OIDC login (https://github.com/jhxxr/XAuth). The first account to log in is bound as the sole admin.
XAUTH_ISSUER=
XAUTH_CLIENT_ID=
XAUTH_CLIENT_SECRET=
# Number of trusted reverse proxy hops; keep 0 for a direct connection.
TRUST_PROXY_HOPS=0
AUDIT_RETENTION_DAYS=90
