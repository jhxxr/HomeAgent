HOST=127.0.0.1
PORT=3210
PUBLIC_URL=http://localhost:3210
HOMEAGENT_DB=./data/server.sqlite
# Run npm run init to generate strong values. ADMIN_PASSWORD is optional when XAuth is configured.
ADMIN_PASSWORD=
SESSION_SECRET=
# Optional XAuth OIDC login (https://github.com/jhxxr/XAuth). The first account to log in is bound as the sole admin.
XAUTH_ISSUER=
XAUTH_CLIENT_ID=
XAUTH_CLIENT_SECRET=
# Number of trusted reverse proxy hops; keep 0 for a direct connection.
TRUST_PROXY_HOPS=0
AUDIT_RETENTION_DAYS=90
# Optional calendar integration. Disabled silently by default; no new dependencies.
CALENDAR_PROVIDER=none
# Google: a refresh token is recommended. Access tokens expire; no automatic login flow.
CALENDAR_ID=primary
CALENDAR_CLIENT_ID=
CALENDAR_CLIENT_SECRET=
CALENDAR_REFRESH_TOKEN=
CALENDAR_ACCESS_TOKEN=
# Omit to create a dedicated HomeAgent Tasks calendar. Never use the personal calendar here.
CALENDAR_TASKS_ID=
# CalDAV: collection URLs must end with /. The tasks collection must be separate.
CALENDAR_URL=
CALENDAR_USERNAME=
CALENDAR_PASSWORD=
# Omit for read-only busy/deadline synchronization.
CALENDAR_TASKS_URL=
# CalDAV all-day event timezone; use the personal calendar's IANA timezone.
CALENDAR_TIMEZONE=UTC
