{
  "name": "homeagent-server",
  "version": "0.4.11",
  "type": "module",
  "description": "Self-hosted MCP relay and web dashboard",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jhxxr/HomeAgent.git"
  },
  "homepage": "https://github.com/jhxxr/HomeAgent#readme",
  "bugs": {
    "url": "https://github.com/jhxxr/HomeAgent/issues"
  },
  "keywords": [
    "mcp",
    "self-hosted",
    "remote-development",
    "automation"
  ],
  "engines": {
    "node": ">=24.14.0"
  },
  "bin": {
    "homeagent-server": "bin/server.mjs"
  },
  "files": [
    "bin/server.mjs",
    "dist/server/**/*.js",
    "dist/shared/**/*.js",
    "public/",
    "scripts/init.mjs",
    "scripts/backup.mjs",
    ".env.example",
    "README.en.md",
    "CONTRIBUTING.md",
    "SECURITY.md",
    "CHANGELOG.md",
    "THIRD_PARTY_NOTICES.md",
    "licenses/",
    "docs/"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "tsc",
    "check": "tsc --noEmit",
    "test": "tsx --test --test-concurrency=1 tests/*.test.ts",
    "server": "node --env-file-if-exists=.env dist/server/cli.js",
    "runner": "node dist/runner/cli.js",
    "dev:server": "tsx --env-file-if-exists=.env src/server/cli.ts",
    "dev:runner": "tsx src/runner/cli.ts",
    "init": "node scripts/init.mjs",
    "notices": "node scripts/third-party.mjs",
    "notices:check": "node scripts/third-party.mjs --check",
    "release:check": "node scripts/check-release.mjs",
    "release:source": "node scripts/package-release.mjs",
    "prepack": "npm run build",
    "release:npm": "npm run build && node scripts/package-npm.mjs",
    "test:package": "node scripts/test-package.mjs",
    "verify": "npm run check && npm run build && npm test && npm run release:check"
  },
  "dependencies": {
    "@modelcontextprotocol/node": "2.1.2",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@modelcontextprotocol/server": "2.4.0",
    "express": "5.3.0",
    "ws": "8.22.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.4.0",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@types/ws": "^8.18.1",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  }
}
